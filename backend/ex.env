NODE_ENV=dev
PORT=3003
MONGODB_DATA_URL=mongodb://user:password@localhost:27017?authSource=admin&readPreference=primary&directConnection=true&ssl=false

NAME_APP=nexora

COMPRESSION=false

# Whitelist origin cho CORS (phân tách bởi dấu phẩy). Bỏ trống = cho phép '*' (chỉ dev).
# Ví dụ: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

SECRET_TOKEN=change_this_secret_token
SECRET_PASS=change_this_secret_pass
SECRET_TOKEN_MASTER=change_this_master_token
SECRET_PASS_MASTER=change_this_master_pass